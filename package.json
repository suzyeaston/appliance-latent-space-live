{
  "name": "appliance-latent-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser instrument for The Appliance Latent Space: type a pattern, hear it, watch it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:audio": "node tests/audio/offline-render.mjs",
    "test:ui": "node tests/audio/ui-smoke.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
